---
import Layout from '../layouts/Layout.astro';
import TextReveal from '../components/TextReveal.jsx';

const pillars = [
  {
    step: '01',
    label: 'Core Objective',
    headline: 'Bridging the Commerce Chasm',
    body: 'Vyapo bridges the structural gap between tier-1 producers and localized storefronts, transforming fragmented distribution channels into an agile, cost-transparent pipeline.',
    metric: 'Zero Middleman Overhead',
    pillColor: 'border-amber-500/30 text-vyapo bg-vyapo/10',
  },
  {
    step: '02',
    label: 'Trade Revolution',
    headline: 'Systematic Supply Operations',
    body: 'Dedicated to modernizing legacy wholesale mechanisms. By unifying manufacturers, regional stockists, distributors, and storefronts under automated order matching, we eliminate stock deadlocks.',
    metric: 'Real-Time Liquidity',
    pillColor: 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10',
  },
  {
    step: '03',
    label: 'Inventory Protocol',
    headline: 'Virtual Manifests & Physical Freight',
    body: 'We orchestrate end-to-end stock verification. Manufacturers mint verified virtual inventory instances that flow synchronously with physical pallets—providing immutable batch custody down to retail POS.',
    metric: 'Dual-Layer Custody',
    pillColor: 'border-cyan-500/30 text-cyan-400 bg-cyan-500/10',
  }
];

const nodes = [
  { role: 'Producers', title: 'Manufacturers', desc: 'Direct manifest issuance' },
  { role: 'Aggregation', title: 'Wholesalers', desc: 'Regional depot custody' },
  { role: 'Routing', title: 'Distributors', desc: 'Last-mile fleet transfer' },
  { role: 'Commerce', title: 'Retailers', desc: 'Point-of-sale liquidity' },
];
---

<Layout title="About Vyapo | The Systematic Commerce Network">
  <div class="relative w-full max-w-full overflow-x-clip bg-transparent text-white selection:bg-vyapo selection:text-black">
    
    <!-- Ambient Background Lighting -->
    <div class="absolute -top-32 right-0 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] bg-vyapo/10 rounded-full blur-[120px] pointer-events-none mix-blend-screen -z-10"></div>
    <div class="absolute top-[45%] -left-20 w-[260px] sm:w-[420px] h-[260px] sm:h-[420px] bg-amber-500/10 rounded-full blur-[130px] pointer-events-none mix-blend-screen -z-10"></div>

    <section class="w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-28 sm:pt-36 pb-20 relative z-10 box-border">
      
      <!-- HERO HEADER -->
      <div class="max-w-3xl mb-14 sm:mb-20">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 font-mono text-[11px] uppercase tracking-[0.25em] text-vyapo mb-5 about-header-elem">
          <span class="w-1.5 h-1.5 rounded-full bg-vyapo animate-ping"></span>
          Decentralized Commerce Protocol
        </div>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight leading-[0.94] about-header-elem">
          The Systematic <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-vyapo">
            Business Network.
          </span>
        </h1>
        <p class="text-white/60 text-base sm:text-xl font-light mt-5 leading-relaxed about-header-elem">
          Vyapo replaces antiquated pen-and-paper wholesale networks with an automated trade layer—connecting producer inventories directly to consumer-facing storefronts.
        </p>
      </div>

      <!-- INFORMATIVE ECOSYSTEM ARCHITECTURE BAR -->
      <div class="mb-16 sm:mb-24 p-5 sm:p-7 rounded-2xl sm:rounded-3xl bg-white/[0.02] border border-white/10 backdrop-blur-md">
        <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/10">
          <span class="font-mono text-[11px] uppercase tracking-widest text-vyapo">Network Topology</span>
          <span class="font-mono text-[11px] text-white/40">4 Synchronized Layers</span>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {nodes.map((n, i) => (
            <div class="relative p-4 rounded-xl bg-white/[0.02] border border-white/5 flex flex-col justify-between min-h-[105px] group hover:border-vyapo/40 transition-colors duration-300">
              <span class="font-mono text-[10px] text-white/40 uppercase tracking-wider">{n.role}</span>
              <div>
                <h4 class="text-base sm:text-lg font-bold text-white uppercase tracking-tight">{n.title}</h4>
                <p class="font-mono text-[10px] sm:text-[11px] text-white/50 mt-0.5">{n.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- MAIN SPLIT: STICKY DESKTOP ANCHOR + STEPWISE TIMELINE -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        
        <!-- Left: Adaptive Anchor Block (Sticky only on lg+) -->
        <div class="lg:col-span-5 relative">
          <div class="lg:sticky lg:top-36 space-y-6">
            <span class="text-xs font-mono text-vyapo uppercase tracking-widest block">Structural Blueprint</span>
            <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white leading-tight">
              Engineering <br class="hidden sm:block"/>
              Fluidity in Trade.
            </h2>
            <p class="text-white/60 text-sm sm:text-base font-light leading-relaxed">
              Every commerce tier operates with isolated data silos. Vyapo links warehouse ERPs, live transport logistics, and retail counter registers into one unified manifest.
            </p>

            <!-- Live Status Node Card -->
            <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 space-y-2">
              <div class="flex items-center justify-between font-mono text-[11px]">
                <span class="text-white/40">State Engine</span>
                <span class="text-emerald-400 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Active Matrix
                </span>
              </div>
              <p class="text-xs text-white/70 font-light">
                Continuous reconciliation between virtual inventory batches and physical bill-of-ladings.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Animated Pillar Cards with Progress Track -->
        <div class="lg:col-span-7 relative timeline-track-wrapper">
          
          <!-- Continuous Vertical GSAP Progress Line -->
          <div class="absolute left-4 sm:left-6 top-3 bottom-8 w-[2px] bg-white/10">
            <div class="progress-bar w-full bg-gradient-to-b from-vyapo via-amber-400 to-emerald-400 h-0 origin-top"></div>
          </div>

          <!-- Timeline Items -->
          <div class="space-y-8 sm:space-y-12 pl-12 sm:pl-16">
            {pillars.map((p, idx) => (
              <div class="timeline-step relative rounded-2xl sm:rounded-3xl bg-white/[0.02] border border-white/10 p-6 sm:p-8 backdrop-blur-md hover:border-white/20 transition-all duration-300">
                
                <!-- Step Circle Anchor -->
                <div class="step-indicator absolute -left-12 sm:-left-16 top-7 w-8 h-8 rounded-full bg-[#0a0a0a] border border-white/20 flex items-center justify-center font-mono text-xs font-bold text-white transition-colors duration-500">
                  {p.step}
                </div>

                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                  <span class={`font-mono text-[10px] uppercase tracking-widest px-2.5 py-0.5 rounded-full border ${p.pillColor}`}>
                    {p.label}
                  </span>
                  <span class="font-mono text-[11px] text-white/40">{p.metric}</span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-white mb-3">
                  {p.headline}
                </h3>

                <p class="text-sm sm:text-base font-light text-white/70 leading-relaxed">
                  {p.body}
                </p>

              </div>
            ))}
          </div>

        </div>

      </div>

    </section>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initAboutMotion = () => {
    // 1. Hero text stagger
    gsap.fromTo(
      '.about-header-elem',
      { y: 35, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.85, stagger: 0.12, ease: 'power3.out', delay: 0.1 }
    );

    // 2. Timeline Step-in and Progress Track Sync
    const timelineSteps = document.querySelectorAll('.timeline-step');
    const progressBar = document.querySelector('.progress-bar');

    if (progressBar && timelineSteps.length > 0) {
      // Pin height of progress line directly to scroll
      gsap.fromTo(
        progressBar,
        { height: '0%' },
        {
          height: '100%',
          ease: 'none',
          scrollTrigger: {
            trigger: '.timeline-track-wrapper',
            start: 'top 70%',
            end: 'bottom 80%',
            scrub: 0.8,
          }
        }
      );

      // Stagger each card and light up indicator circle
      timelineSteps.forEach((step) => {
        const indicator = step.querySelector('.step-indicator');

        gsap.fromTo(
          step,
          { y: 40, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.8,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: step,
              start: 'top 85%',
              onEnter: () => {
                if (indicator) {
                  gsap.to(indicator, {
                    borderColor: '#F59E0B',
                    color: '#F59E0B',
                    boxShadow: '0 0 15px rgba(245, 158, 11, 0.4)',
                    duration: 0.4,
                  });
                }
              },
              onLeaveBack: () => {
                if (indicator) {
                  gsap.to(indicator, {
                    borderColor: 'rgba(255, 255, 255, 0.2)',
                    color: '#FFFFFF',
                    boxShadow: 'none',
                    duration: 0.4,
                  });
                }
              }
            }
          }
        );
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initAboutMotion);
  document.addEventListener('astro:page-load', initAboutMotion);
</script>