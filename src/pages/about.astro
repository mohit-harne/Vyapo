---
import Layout from '../layouts/Layout.astro';

const visionPillars = [
  {
    code: 'V-01',
    label: 'Direct Supply',
    heading: 'Factory to Counter',
    desc: 'Cutting out multi-layer middlemen so local factories can sell and dispatch goods directly to neighborhood retail shops without delays.',
    stat: 'Zero Delays'
  },
  {
    code: 'V-02',
    label: 'Live Inventory',
    heading: 'Instant Stock Updates',
    desc: 'Connecting factory dispatches, delivery trucks, and shop billing into one live system so nobody runs out of stock or loses track of goods.',
    stat: 'Live Tracking'
  },
  {
    code: 'V-03',
    label: 'Cash Flow Support',
    heading: 'Working Capital for Merchants',
    desc: 'Helping small shopkeepers and mandi traders keep cash moving with clear digital records and dependable stock access.',
    stat: '₹5 Cr+ Unlocked'
  }
];

const teamMembers = [
  {
    name: 'Roshan Padole',
    role: 'Head of Field Operations',
    focus: 'Mandi Partnerships & Daily Delivery Logistics',
    tag: 'Field Operations',
    image: '/staff/roshanpadole.jpg'
  },
  {
    name: 'Mohit Harne',
    role: 'Full Stack Developer',
    focus: 'Web Platform, User Experience & Ground Operations',
    tag: 'Core Execution',
    image: '/staff/mohitharne.jpeg'
  },
  {
    name: 'Ananya Sharma',
    role: 'Lead Systems Engineer',
    focus: 'Live Stock Sync & Fast Catalog APIs',
    tag: 'Platform Tech',
    image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80'
  },
  {
    name: 'Rajesh Kulkarni',
    role: 'Trade Logistics Director',
    focus: 'Highway Freight Routes & Regional Godowns',
    tag: 'Trucking & Transit',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=800&q=80'
  }
];
---

<Layout title="About Vyapo | Founder Story, Vision & Team">
  <div class="relative w-full max-w-full overflow-x-clip bg-[#0a0a0a] text-white selection:bg-[#FCA500] selection:text-black">
    
    <!-- Ambient Backdrop Lighting -->
    <div class="absolute -top-40 right-1/4 w-[350px] sm:w-[600px] h-[350px] sm:h-[600px] bg-[#FCA500]/10 rounded-full blur-[140px] pointer-events-none mix-blend-screen -z-10"></div>
    <div class="absolute top-1/3 -left-32 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] bg-[#FCA500]/10 rounded-full blur-[160px] pointer-events-none mix-blend-screen -z-10"></div>

    <section class="w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-28 sm:pt-36 pb-20 relative z-10 box-border">

      <!-- SECTION 01: EDITORIAL HEADER -->
      <div class="max-w-4xl mb-16 sm:mb-24">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 font-mono text-[11px] uppercase tracking-[0.25em] text-[#FCA500] mb-6 about-reveal">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FCA500] animate-ping"></span>
          Our Background & Mission
        </div>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight leading-[0.92] about-reveal">
          Built for <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white/90 to-[#FCA500]">
            Real Ground Trade.
          </span>
        </h1>
        <p class="text-white/70 text-base sm:text-xl font-light mt-6 leading-relaxed max-w-2xl about-reveal">
          Vyapo was built right on factory floors, grain mandis, and busy transport routes—replacing slow middlemen and lost paperwork with direct digital supply.
        </p>
      </div>

      <!-- SECTION 02: FOUNDER STORY -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center mb-28 sm:mb-36">
        
        <!-- Left: Founder Frame -->
        <div class="lg:col-span-5 flex justify-center">
          <div 
            id="founder-tilt-card" 
            class="relative w-full max-w-md aspect-[4/5] rounded-3xl overflow-hidden border border-white/10 bg-white/[0.02] backdrop-blur-xl group cursor-default transition-all duration-300 shadow-[0_20px_50px_rgba(0,0,0,0.8)]"
          >
            <img 
              src="/staff/vikasvishvalata.jpg" 
              alt="Vikas Vishvalata - Founder of Vyapo" 
              class="founder-img w-full h-full object-cover filter contrast-110 brightness-90 group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />

            <!-- Shimmer Highlight Layer -->
            <div class="founder-sheen absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.08] to-transparent pointer-events-none opacity-0 transition-opacity duration-300"></div>

            <!-- Dark Gradient Scrim -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/30 to-transparent pointer-events-none"></div>

            <!-- Overlay on Card -->
            <div class="absolute bottom-6 left-6 right-6 z-20">
              <div class="flex items-center justify-between font-mono text-[11px] text-[#FCA500] mb-1">
                <span>FOUNDER</span>
                <span class="flex items-center gap-1.5 text-emerald-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Active on Ground
                </span>
              </div>
              <h3 class="text-2xl font-bold uppercase tracking-tight text-white mb-0.5">Vikas Vishvalata</h3>
              <p class="font-mono text-xs text-white/50">Founder, Vyapo & Vyaparnama</p>
            </div>
          </div>
        </div>

        <!-- Right: The Founder Journey -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#FCA500]">
            <span>// The Story</span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight leading-snug text-white">
            "We didn't build this from an AC office. We built it where trucks load and goods move."
          </h2>

          <div class="space-y-4 text-white/70 font-light text-sm sm:text-base leading-relaxed">
            <p>
              Visiting textile mills across Surat and spinning plants in Maharashtra made one big problem clear: factories had full warehouses, but local shopkeepers were waiting weeks for stock while stuck in heavy 60-to-90 day credit cycles.
            </p>
            <p>
              Multiple middlemen were taking cuts without adding real value, and paper bills caused trucks to sit idle at highway checkposts and weighbridges for days.
            </p>
            <p class="border-l-2 border-[#FCA500] pl-4 italic text-white/90">
              Vyapo was built with a simple goal: allow factories to show their live inventory directly to shopkeepers, so orders can be placed, shipped, and settled without friction.
            </p>
          </div>

          <div class="pt-4 grid grid-cols-2 sm:grid-cols-3 gap-4 border-t border-white/10 font-mono">
            <div>
              <div class="text-2xl font-black text-[#FCA500]">200+</div>
              <div class="text-[11px] text-white/40 uppercase mt-0.5">Factories Visited</div>
            </div>
            <div>
              <div class="text-2xl font-black text-white">Direct</div>
              <div class="text-[11px] text-white/40 uppercase mt-0.5">Connected Network</div>
            </div>
            <div>
              <div class="text-2xl font-black text-emerald-400">100%</div>
              <div class="text-[11px] text-white/40 uppercase mt-0.5">Clear Settlements</div>
            </div>
          </div>
        </div>

      </div>

      <!-- SECTION 03: THE VISION -->
      <div class="mb-28 sm:mb-36">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 pb-4 border-b border-white/10 gap-4">
          <div>
            <span class="font-mono text-xs uppercase tracking-widest text-[#FCA500] block mb-2">// What We Stand For</span>
            <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Our Vision</h2>
          </div>
          <p class="font-mono text-xs text-white/40 max-w-xs sm:text-right">
            Making trade simple, transparent, and direct across India.
          </p>
        </div>

        <!-- Vision Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 vision-cards-container">
          {visionPillars.map((v) => (
            <div class="vision-card p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/[0.02] border border-white/10 flex flex-col justify-between hover:border-[#FCA500]/50 transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between font-mono text-xs text-white/40 mb-6">
                  <span class="text-[#FCA500] font-bold">{v.code}</span>
                  <span class="px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-white/80">{v.stat}</span>
                </div>
                <span class="font-mono text-[10px] uppercase tracking-wider text-white/50 block mb-2">{v.label}</span>
                <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-white group-hover:text-[#FCA500] transition-colors mb-4">
                  {v.heading}
                </h3>
                <p class="text-white/60 text-sm font-light leading-relaxed">
                  {v.desc}
                </p>
              </div>

              <div class="pt-6 mt-8 border-t border-white/5 flex items-center justify-between font-mono text-xs text-white/30 group-hover:text-[#FCA500] transition-colors">
                <span>Learn More</span>
                <span>→</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- SECTION 04: THE OPERATORS / TEAM -->
      <div>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 pb-4 border-b border-white/10 gap-4">
          <div>
            <span class="font-mono text-xs uppercase tracking-widest text-[#FCA500] block mb-2">// The Team</span>
            <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Our Team</h2>
          </div>
          <div class="font-mono text-xs text-white/40">
            Engineers, field leaders, and logistics specialists.
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {teamMembers.map((member) => (
            <div class="team-card group relative p-5 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-[#FCA500]/40 transition-all duration-300 flex flex-col">
              
              <!-- Portrait Image Container -->
              <div class="relative w-full aspect-[4/4.5] rounded-xl overflow-hidden bg-black/40 border border-white/10 mb-4">
                <img 
                  src={member.image} 
                  alt={member.name}
                  class="team-photo w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
                <div class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-md bg-black/70 backdrop-blur-md border border-white/15 text-[10px] font-mono uppercase tracking-widest text-[#FCA500]">
                  {member.tag}
                </div>
              </div>

              <!-- Content -->
              <div class="flex-grow flex flex-col justify-between">
                <div>
                  <h3 class="text-lg font-bold uppercase tracking-tight text-white group-hover:text-[#FCA500] transition-colors">
                    {member.name}
                  </h3>
                  <p class="font-mono text-xs text-[#FCA500]/90 mt-0.5 mb-2">{member.role}</p>
                  <p class="text-xs text-white/60 font-light leading-relaxed">
                    {member.focus}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between font-mono text-[10px] text-white/30">
                  <span>Verified</span>
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/80"></span>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>

    </section>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initAboutPageAnimations = () => {
    // 1. Header reveal stagger
    gsap.fromTo(
      '.about-reveal',
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, stagger: 0.12, ease: 'power3.out' }
    );

    // 2. 3D Gyroscope/Mouse Tilt Effect on Founder Card
    const founderCard = document.getElementById('founder-tilt-card');
    const founderSheen = document.querySelector('.founder-sheen') as HTMLElement;

    if (founderCard && window.matchMedia('(pointer: fine)').matches) {
      const xRot = gsap.quickTo(founderCard, 'rotationY', { duration: 0.35, ease: 'power2.out' });
      const yRot = gsap.quickTo(founderCard, 'rotationX', { duration: 0.35, ease: 'power2.out' });

      founderCard.addEventListener('mousemove', (e) => {
        const rect = founderCard.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        xRot((x / (rect.width / 2)) * 10);
        yRot(-(y / (rect.height / 2)) * 10);

        if (founderSheen) {
          gsap.to(founderSheen, { opacity: 0.8, duration: 0.2 });
        }
      });

      founderCard.addEventListener('mouseleave', () => {
        xRot(0);
        yRot(0);
        if (founderSheen) {
          gsap.to(founderSheen, { opacity: 0, duration: 0.4 });
        }
      });
    }

    // 3. Staggered Scale-In for Vision Cards
    const visionCards = document.querySelectorAll('.vision-card');
    if (visionCards.length) {
      gsap.fromTo(
        visionCards,
        { y: 40, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          stagger: 0.15,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.vision-cards-container',
            start: 'top 80%',
          }
        }
      );
    }

    // 4. Team Card Scroll Reveal
    const teamCards = document.querySelectorAll('.team-card');
    if (teamCards.length) {
      gsap.fromTo(
        teamCards,
        { y: 35, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.65,
          stagger: 0.1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: teamCards[0],
            start: 'top 85%',
          }
        }
      );
    }
  };

  document.addEventListener('DOMContentLoaded', initAboutPageAnimations);
  document.addEventListener('astro:page-load', initAboutPageAnimations);
</script>