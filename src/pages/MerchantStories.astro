---
import Layout from '../layouts/Layout.astro';

const stories = [
  {
    partner: "Kisan Agro Supplies",
    role: "Fertilizer & Seed Wholesaler",
    location: "Amravati Region, Maharashtra",
    stat: "4.2x",
    statLabel: "Capital Turnover Rate",
    quote: "Virtual inventory allocation allowed us to pre-sell seasonal stock to 120+ retail partners before it even left the rail siding. Vyapo cut our credit disputes to zero."
  },
  {
    partner: "Metro FMCG Distributors",
    role: "Central Hub Distributor",
    location: "Pune, Maharashtra",
    stat: "68%",
    statLabel: "Shrinkage & Leakage Reduction",
    quote: "Dispatch reconciliations used to take four days every month. With dual ledger tracking, physical dispatches balance against virtual credits at every driver checkpoint."
  }
];
---

<Layout title="Merchant Stories | Vyapo">
  <section class="py-40 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-24">
      <div class="lg:col-span-5 relative">
        <div class="sticky top-40">
          <span class="text-xs font-mono uppercase tracking-[0.3em] text-vyapo mb-4 block">Ground Reality</span>
          <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter mb-6">
            Merchant <br/> Voices.
          </h1>
          <div class="w-20 h-1 bg-vyapo"></div>
        </div>
      </div>
      <div class="lg:col-span-7 flex items-end">
        <p class="text-xl md:text-3xl font-light text-white/60 leading-relaxed">
          How operators across agriculture, FMCG, and industrial distribution eliminate dead capital and scale operations with Vyapo.
        </p>
      </div>
    </div>

    <!-- Stories List -->
    <div class="space-y-28">
      {stories.map((story) => (
        <div class="story-block border border-white/10 rounded-3xl p-8 md:p-14 bg-white/[0.02] backdrop-blur-xl">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-4 border-b lg:border-b-0 lg:border-r border-white/10 pb-8 lg:pb-0 lg:pr-8">
              <span class="text-6xl md:text-7xl font-black tracking-tighter text-vyapo block mb-2">
                {story.stat}
              </span>
              <span class="text-sm font-mono uppercase tracking-widest text-white/50 block mb-6">
                {story.statLabel}
              </span>
              <div class="border-t border-white/10 pt-4">
                <h4 class="text-xl font-bold text-white">{story.partner}</h4>
                <p class="text-sm text-white/50">{story.role}</p>
                <p class="text-xs font-mono text-vyapo mt-1">{story.location}</p>
              </div>
            </div>

            <div class="lg:col-span-8">
              <blockquote class="text-2xl md:text-3xl font-light text-white/90 leading-relaxed">
                “{story.quote}”
              </blockquote>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const blocks = document.querySelectorAll('.story-block');
  blocks.forEach((block) => {
    gsap.from(block, {
      scrollTrigger: {
        trigger: block,
        start: 'top 85%',
        end: 'top 40%',
        scrub: 1,
      },
      clipPath: 'inset(10% 0% 10% 0% round 24px)',
      opacity: 0.3,
      y: 40,
      ease: 'none'
    });
  });
</script>