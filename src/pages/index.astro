---
import Layout from '../layouts/Layout.astro';
import KineticHero from '../components/KineticHero.jsx';
import TextReveal from '../components/TextReveal.jsx';
import MagneticButton from '../components/MagneticButton.jsx';

const reviews = [
  {
    name: "Rajesh K. Singhania",
    role: "Proprietor, Singhania Textiles",
    hub: "Surat, Gujarat",
    rating: "5.0",
    date: "Verified Wholesaler",
    comment: "Connecting directly with mill producers unlocked 30% faster restocking. Digitizing our wholesale manifests eradicated duplicate order books overnight.",
    metric: "4.8x Turnover"
  },
  {
    name: "Amitabh Deshmukh",
    role: "Lead Stockist, Sahyadri FMCG",
    hub: "Bhiwandi Hub, Maharashtra",
    rating: "5.0",
    date: "Regional Depot Partner",
    comment: "The e-way bill reconciliation and automated invoice discounting saved us weeks of credit deadlock. Real-time truck dispatch sync is flawless.",
    metric: "Zero Stockouts"
  },
  {
    name: "Vikas & Sons Retail",
    role: "Retail Storefront Network",
    hub: "Pune Corridor",
    rating: "4.9",
    date: "Kirana Trade Network",
    comment: "Scanning bulk cartons immediately pushes live stock to our storefront and WhatsApp catalog. Truly transformed how Tier-2 storefronts operate.",
    metric: "Sub-Second Sync"
  },
  {
    name: "Gurpreet Singh Chawla",
    role: "Managing Director, Chawla Auto Spares",
    hub: "Kashmere Gate, Delhi",
    rating: "5.0",
    date: "Automotive Wholesale",
    comment: "Real-time dispatch telemetry gives our Tier-3 sub-dealers 100% confidence on parts arrival. No unverified shrinkage, zero payment disputes.",
    metric: "100% Audit Track"
  },
  {
    name: "Senthil Murugan Traders",
    role: "Commodities Distributor",
    hub: "APMC Yard, Vashi",
    rating: "4.9",
    date: "Agri-Wholesale Exchange",
    comment: "Offline-first sync on terminal tablets means our weighbridge operators continue billing even during network dropouts without data collisions.",
    metric: "0ms Downtime"
  }
];

const onboardingSteps = [
  {
    step: "01",
    title: "Mobile & OTP Handshake",
    status: "Sub-second",
    desc: "Enter business mobile number. Instant 6-digit cryptographic SMS OTP authentication without password overhead."
  },
  {
    step: "02",
    title: "Trade Persona & GSTIN",
    status: "Auto-Fetch",
    desc: "Select Manufacturer, Stockist, or Kirana. Input GSTIN or Udyam ID for instant automated business registration."
  },
  {
    step: "03",
    title: "Direct Warehouse Sourcing",
    status: "Zero Middleman",
    desc: "Connect directly to verified mill suppliers and local depots with live stock price brackets and dynamic credit limits."
  },
  {
    step: "04",
    title: "Live Storefront Sync",
    status: "Terminal Ready",
    desc: "Launch WhatsApp catalog automation, invoice discounting lines, and barcode POS registers with 1-click provisioning."
  }
];
---

<Layout title="Home">
  <div class="relative w-full max-w-full overflow-x-clip bg-transparent text-white selection:bg-vyapo selection:text-black">
    <KineticHero client:load />

    <!-- ============================================================== -->
    <!-- 1. SPLIT STAGE: APP PROMO (LEFT) + REGISTRATION GUIDE (RIGHT)  -->
    <!-- ============================================================== -->
    <section class="video-promo-section relative px-4 sm:px-8 md:px-12 py-12 sm:py-16 max-w-7xl mx-auto box-border overflow-x-clip">
      
      <div class="text-center max-w-xl mx-auto mb-8 sm:mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-vyapo/10 border border-vyapo/20 font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.25em] text-vyapo mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Seamless Onboarding Protocol
        </div>
        <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white leading-tight">
          Next-Gen Trade, <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-vyapo">
            Zero-Friction Access.
          </span>
        </h2>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 sm:-inset-6 bg-gradient-to-b from-vyapo/15 via-amber-500/5 to-transparent rounded-[2rem] blur-3xl pointer-events-none -z-10 opacity-70"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
          
          <!-- ================= LEFT: NATURAL ASPECT VIDEO CONTAINER ================= -->
          <div class="lg:col-span-6 flex flex-col justify-center">
            <div class="w-full max-w-xl mx-auto rounded-2xl sm:rounded-3xl border border-white/15 bg-black/90 backdrop-blur-xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.85)] relative">
              
              <!-- Terminal Header Bar -->
              <div class="flex items-center justify-between px-4 sm:px-5 py-2.5 border-b border-white/10 bg-[#0e0e0e] font-mono text-[9px] sm:text-[10px] text-white/50 relative z-20">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                  <span class="text-white font-bold">VYAPO_OS // LIVE PREVIEW</span>
                </div>
                <span class="text-vyapo uppercase tracking-wider">H.264 Stream</span>
              </div>

              <!-- Natural 16:9 Aspect Video Box (Zero letterbox, edges flush to container) -->
              <div class="relative w-full aspect-video bg-black flex items-center justify-center overflow-hidden">
                <video
                  id="vyapo-promo-player"
                  src="/Vyapo_promo.mp4"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="auto"
                  class="w-full h-full object-contain pointer-events-none"
                ></video>

                <!-- Subtle Laser Scanline -->
                <div class="video-laser-scanner absolute left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-vyapo to-transparent opacity-80 pointer-events-none z-20"></div>

                <!-- In-video bottom status bar -->
                <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none z-20">
                  <span class="px-2.5 py-0.5 rounded-full bg-black/85 backdrop-blur-md border border-white/15 text-[8px] sm:text-[9px] font-mono text-emerald-400 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Autoplay Active
                  </span>
                  <span class="px-2.5 py-0.5 rounded-full bg-black/85 backdrop-blur-md text-[8px] font-mono text-white/50 uppercase tracking-widest hidden sm:inline-block">
                    Stream Synced
                  </span>
                </div>
              </div>

            </div>
          </div>

          <!-- ================= RIGHT: REGISTRATION GUIDE ================= -->
          <div class="lg:col-span-6 flex flex-col justify-between rounded-2xl sm:rounded-3xl border border-white/15 bg-white/[0.02] backdrop-blur-xl p-5 sm:p-7 shadow-[0_20px_50px_rgba(0,0,0,0.85)] relative overflow-hidden">
            
            <div class="absolute top-0 right-0 w-44 h-44 bg-vyapo/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

            <div>
              <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/10 font-mono text-[10px]">
                <span class="text-vyapo uppercase tracking-widest flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-vyapo animate-pulse"></span>
                  Merchant Gateway
                </span>
                <span id="onboarding-cycle-counter" class="text-white/40 font-mono">FLOW: STEP 01</span>
              </div>

              <h3 class="text-lg sm:text-xl font-bold uppercase tracking-tight text-white mb-1">
                Onboard in 60 Seconds
              </h3>
              <p class="text-xs text-white/50 font-light leading-relaxed mb-5">
                Instant KYC-less registration for local retailers, wholesalers, and manufacturers.
              </p>

              <div id="onboarding-steps-container" class="relative pl-5 sm:pl-6 space-y-2.5 sm:space-y-3">
                <!-- Vertical Line to the Left of Numbers -->
                <div class="absolute left-1.5 top-3 bottom-3 w-[2px] bg-white/10 rounded-full"></div>
                <div id="onboarding-track-fill" class="absolute left-1.5 top-3 w-[2px] bg-vyapo rounded-full transition-all duration-500" style="height: 0%;"></div>

                {onboardingSteps.map((s, idx) => (
                  <div 
                    class={`onboard-step onboard-step-${idx} group relative flex items-start gap-3 p-2.5 sm:p-3 rounded-xl border border-white/5 bg-white/[0.015] transition-all duration-500 cursor-pointer overflow-hidden`}
                    data-step-index={idx}
                  >
                    <div class="step-indicator absolute left-0 top-0 bottom-0 w-[2.5px] bg-vyapo scale-y-0 transition-transform duration-300 origin-top"></div>

                    <div class="step-badge w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-black border border-white/20 text-vyapo font-mono text-[10px] font-bold flex items-center justify-center flex-shrink-0 relative z-10 transition-all duration-300">
                      {s.step}
                    </div>

                    <div class="flex-1 relative z-10 min-w-0">
                      <div class="flex items-center justify-between gap-2">
                        <h4 class="step-title text-xs sm:text-sm font-bold uppercase tracking-tight text-white transition-colors duration-300 truncate">
                          {s.title}
                        </h4>
                        <span class="step-status font-mono text-[9px] text-white/40 transition-colors duration-300 flex-shrink-0">
                          {s.status}
                        </span>
                      </div>
                      <p class="step-desc text-[11px] text-white/50 leading-relaxed font-light mt-0.5 transition-colors duration-300">
                        {s.desc}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-4 mt-4 border-t border-white/10 flex items-center justify-between gap-3">
              <a
                href="/download"
                class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-vyapo text-black font-bold text-xs uppercase tracking-wider hover:bg-amber-400 transition-all shadow-[0_0_20px_rgba(245,158,11,0.25)] hover:shadow-[0_0_25px_rgba(245,158,11,0.4)] [@media(pointer:fine)]:cursor-none"
              >
                Get App To Register
                <span class="text-sm font-bold">↗</span>
              </a>
              <a
                href="/contact"
                class="px-4 py-2.5 rounded-xl border border-white/15 bg-white/[0.02] text-white/70 hover:text-white hover:border-white/30 text-xs font-mono uppercase tracking-wider transition-all [@media(pointer:fine)]:cursor-none"
              >
                Sign In
              </a>
            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- ============================================================== -->
    <!-- 2. ECOSYSTEM MISSION SECTION                                   -->
    <!-- ============================================================== -->
    <section class="mission-section flex flex-col items-center justify-center px-6 md:px-12 py-16 lg:py-20 relative overflow-hidden box-border">
      
      <div class="absolute inset-0 pointer-events-none select-none overflow-hidden -z-10">
        <div 
          class="mission-glow-1 absolute -top-1/4 -left-1/4 w-[55vw] max-w-[650px] aspect-square rounded-full blur-[130px] opacity-25 mix-blend-screen pointer-events-none"
          style="background: radial-gradient(circle, #FFA000 0%, #F59E0B 45%, transparent 70%);"
        ></div>

        <div 
          class="mission-glow-2 absolute -bottom-1/4 -right-1/4 w-[60vw] max-w-[700px] aspect-square rounded-full blur-[140px] opacity-20 mix-blend-screen pointer-events-none"
          style="background: radial-gradient(circle, #FFB300 0%, #D97706 50%, transparent 75%);"
        ></div>

        <div 
          class="mission-center-halo absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[40vw] max-w-[500px] aspect-square rounded-full blur-[100px] opacity-10 mix-blend-screen pointer-events-none"
          style="background: radial-gradient(circle, #F59E0B 0%, transparent 65%);"
        ></div>

        <div 
          class="absolute inset-0 opacity-[0.06] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"
          style="background-image: linear-gradient(to right, #FFA000 1px, transparent 1px), linear-gradient(to bottom, #FFA000 1px, transparent 1px); background-size: 50px 50px;"
        ></div>
      </div>

      <div class="max-w-5xl mx-auto text-center flex flex-col items-center relative z-10">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-vyapo/10 border border-vyapo/20 font-mono text-[11px] uppercase tracking-[0.25em] text-vyapo mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-vyapo animate-ping"></span>
          Ecosystem Mission
        </div>

        <TextReveal client:load>
          <p class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-white/60 font-light leading-snug md:leading-tight mb-10 lg:mb-14">
            Vyapo is a digital commerce platform connecting <span class="text-white font-medium">manufacturers, wholesalers, distributors, and retailers.</span> A digital merchant directory redefining the supply chain.
          </p>
        </TextReveal>

        <MagneticButton client:load href="/network" className="[@media(pointer:fine)]:cursor-none block active:scale-95 transition-transform">
          <div class="px-7 py-3.5 sm:px-9 sm:py-4 lg:px-10 lg:py-5 rounded-full border border-white/20 hover:bg-vyapo hover:border-vyapo hover:text-[#0a0a0a] transition-all duration-500 flex items-center justify-center gap-4 group backdrop-blur-sm bg-black/20">
            <span class="text-xs sm:text-sm uppercase tracking-[0.2em] font-bold group-hover:tracking-[0.3em] transition-all duration-500">
              Explore the Network
            </span>
            <div class="w-2 h-2 rounded-full bg-vyapo group-hover:bg-[#0a0a0a] transition-colors duration-500"></div>
          </div>
        </MagneticButton>

      </div>
    </section>

    <!-- ============================================================== -->
    <!-- 3. CORE CAPABILITIES                                           -->
    <!-- ============================================================== -->
    <section class="px-6 md:px-12 py-16 lg:py-24 max-w-7xl mx-auto border-t border-white/5 relative z-10 box-border overflow-x-clip">
      <TextReveal client:load>
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-black uppercase tracking-tighter mb-12 lg:mb-20">
          Core <span class="text-transparent [-webkit-text-stroke:1px_#F59E0B] [-webkit-text-fill-color:transparent]">Capabilities.</span>
        </h2>
      </TextReveal>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-8 items-stretch capabilities-grid">
        
        <!-- Capability 01 -->
        <div class="h-full">
          <TextReveal client:load>
            <div class="group border-l border-white/20 pl-6 h-full flex flex-col justify-start hover:border-vyapo transition-colors duration-500 relative">
              <div class="absolute w-2 h-2 bg-vyapo rounded-full -left-[4.5px] top-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_10px_#F59E0B]"></div>
              <p class="text-vyapo tracking-widest uppercase text-xs mb-3 font-mono">01</p>
              <h3 class="text-xl sm:text-2xl font-bold mb-3 uppercase tracking-wider text-white group-hover:text-vyapo transition-colors duration-500">Digital Stock Ledger</h3>
              <p class="text-white/50 text-sm sm:text-base leading-relaxed font-light">
                Manufacturers tokenize and manage a real-time digitized catalog, providing instant allocation transparency across regional warehousing channels before physical dispatch.
              </p>
            </div>
          </TextReveal>
        </div>

        <!-- Capability 02 -->
        <div class="h-full">
          <TextReveal client:load>
            <div class="group border-l border-white/20 pl-6 h-full flex flex-col justify-start hover:border-vyapo transition-colors duration-500 relative">
              <div class="absolute w-2 h-2 bg-vyapo rounded-full -left-[4.5px] top-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_10px_#F59E0B]"></div>
              <p class="text-vyapo tracking-widest uppercase text-xs mb-3 font-mono">02</p>
              <h3 class="text-xl sm:text-2xl font-bold mb-3 uppercase tracking-wider text-white group-hover:text-vyapo transition-colors duration-500">Seamless Transfer</h3>
              <p class="text-white/50 text-sm sm:text-base leading-relaxed font-light">
                Enables transparent, traceable, and audited freight movement from the factory dock directly to regional stockists and storefront counters.
              </p>
            </div>
          </TextReveal>
        </div>

        <!-- Capability 03 -->
        <div class="h-full">
          <TextReveal client:load>
            <div class="group border-l border-white/20 pl-6 h-full flex flex-col justify-start hover:border-vyapo transition-colors duration-500 relative">
              <div class="absolute w-2 h-2 bg-vyapo rounded-full -left-[4.5px] top-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_10px_#F59E0B]"></div>
              <p class="text-vyapo tracking-widest uppercase text-xs mb-3 font-mono">03</p>
              <h3 class="text-xl sm:text-2xl font-bold mb-3 uppercase tracking-wider text-white group-hover:text-vyapo transition-colors duration-500">Retail Empowerment</h3>
              <p class="text-white/50 text-sm sm:text-base leading-relaxed font-light">
                Empowers localized retailers by providing live pipeline stock visibility, enabling seamless synchronization with counter POS registers and instant customer fulfillment.
              </p>
            </div>
          </TextReveal>
        </div>

      </div>
    </section>

    <!-- ============================================================== -->
    <!-- 4. INTERACTIVE 3D REVIEWS SLIDER (Manual Drag + Infinite Loop) -->
    <!-- ============================================================== -->
    <section class="reviews-section px-4 sm:px-8 md:px-12 py-16 sm:py-24 max-w-7xl mx-auto border-t border-white/10 relative box-border overflow-x-clip">
      
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-vyapo/5 rounded-full blur-[140px] pointer-events-none -z-10"></div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-14">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-400/10 border border-emerald-400/20 font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-emerald-400 mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Verified Network Sentiment
          </div>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white leading-tight">
            Trusted By Merchants <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-vyapo">
              Across India.
            </span>
          </h2>
        </div>

        <div class="flex items-center gap-3">
          <button 
            id="prev-review-btn" 
            aria-label="Previous Review"
            class="w-10 h-10 rounded-full border border-white/15 bg-white/[0.03] hover:border-vyapo hover:bg-vyapo hover:text-black flex items-center justify-center transition-all duration-300 [@media(pointer:fine)]:cursor-none active:scale-95"
          >
            ←
          </button>
          <button 
            id="next-review-btn" 
            aria-label="Next Review"
            class="w-10 h-10 rounded-full border border-white/15 bg-white/[0.03] hover:border-vyapo hover:bg-vyapo hover:text-black flex items-center justify-center transition-all duration-300 [@media(pointer:fine)]:cursor-none active:scale-95"
          >
            →
          </button>
        </div>
      </div>

      <!-- Stage with overflow containment preventing horizontal window scroll -->
      <div class="reviews-stage relative w-full overflow-x-clip py-8 select-none [perspective:1400px] touch-pan-y cursor-grab active:cursor-grabbing">
        
        <div id="reviews-track" class="flex items-center justify-start gap-4 sm:gap-6 will-change-transform">
          {reviews.map((rev, i) => (
            <div 
              class="review-card flex-shrink-0 w-[84vw] sm:w-[400px] md:w-[440px] p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/[0.02] border border-white/10 backdrop-blur-xl transition-all duration-500 relative flex flex-col justify-between min-h-[290px] overflow-hidden shadow-2xl"
              data-index={i}
            >
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none bg-[radial-gradient(circle_at_top_right,rgba(245,158,11,0.15)_0%,transparent_70%)]"></div>
              
              <div class="review-indicator absolute left-0 top-0 bottom-0 w-[3px] bg-vyapo scale-y-0 transition-transform duration-300 origin-top"></div>

              <div>
                <div class="flex items-center justify-between mb-4 relative z-10">
                  <div class="flex items-center gap-1 text-vyapo text-sm">
                    <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                  </div>
                  <span class="font-mono text-[10px] text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 px-2 py-0.5 rounded-full">
                    {rev.metric}
                  </span>
                </div>

                <p class="text-white/80 text-sm sm:text-base font-light leading-relaxed mb-6 relative z-10 pointer-events-none">
                  "{rev.comment}"
                </p>
              </div>

              <div class="pt-4 border-t border-white/10 relative z-10 pointer-events-none">
                <h4 class="text-base font-bold text-white uppercase tracking-tight">
                  {rev.name}
                </h4>
                <p class="text-xs text-white/50 font-light mt-0.5">{rev.role}</p>
                <div class="flex items-center justify-between text-[11px] font-mono text-white/40 mt-2">
                  <span>{rev.hub}</span>
                  <span class="text-vyapo/90 font-medium">{rev.date}</span>
                </div>
              </div>

            </div>
          ))}
        </div>

        <div id="reviews-dots" class="flex justify-center items-center gap-2 mt-8">
          {reviews.map((_, i) => (
            <button 
              data-dot-index={i}
              aria-label={`Go to review ${i + 1}`}
              class={`w-2 h-2 rounded-full transition-all duration-300 ${i === 2 ? 'w-6 bg-vyapo' : 'bg-white/20 hover:bg-white/40'} [@media(pointer:fine)]:cursor-none`}
            ></button>
          ))}
        </div>

      </div>

    </section>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initPageInteractions = () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());

    // 1. Mission Ambient Drift
    gsap.to('.mission-glow-1', {
      x: '25%',
      y: '18%',
      scale: 1.15,
      duration: 10,
      ease: 'sine.inOut',
      repeat: -1,
      yoyo: true,
    });

    gsap.to('.mission-glow-2', {
      x: '-20%',
      y: '-20%',
      scale: 0.9,
      duration: 12,
      ease: 'sine.inOut',
      repeat: -1,
      yoyo: true,
      delay: 1,
    });

    // 2. Video Laser Scanner Loop
    gsap.to('.video-laser-scanner', {
      top: '100%',
      duration: 2.2,
      repeat: -1,
      ease: 'power1.inOut',
      yoyo: true,
    });

    // 3. Timed Simulated Onboarding Flow Cycler
    const stepCards = document.querySelectorAll('.onboard-step');
    const counterLabel = document.getElementById('onboarding-cycle-counter');
    const trackFill = document.getElementById('onboarding-track-fill');
    const stepsContainer = document.getElementById('onboarding-steps-container');

    if (stepCards.length > 0) {
      let currentStep = 0;
      let cycleTimer: ReturnType<typeof setInterval> | null = null;
      const totalSteps = stepCards.length;

      const activateStep = (index: number) => {
        currentStep = index;

        if (trackFill) {
          const percent = (index / (totalSteps - 1)) * 100;
          trackFill.style.height = `${percent}%`;
        }

        if (counterLabel) {
          counterLabel.textContent = `FLOW: STEP 0${index + 1} / 04`;
        }

        stepCards.forEach((card, idx) => {
          const el = card as HTMLElement;
          const indicator = el.querySelector('.step-indicator');
          const badge = el.querySelector('.step-badge');
          const title = el.querySelector('.step-title');
          const status = el.querySelector('.step-status');
          const desc = el.querySelector('.step-desc');

          if (idx === index) {
            gsap.to(el, {
              backgroundColor: 'rgba(255, 255, 255, 0.05)',
              borderColor: 'rgba(245, 158, 11, 0.4)',
              boxShadow: '0 8px 25px rgba(245, 158, 11, 0.12)',
              x: 4,
              duration: 0.4,
              ease: 'power2.out',
            });

            if (indicator) gsap.to(indicator, { scaleY: 1, duration: 0.3 });
            if (badge) {
              badge.classList.add('bg-vyapo', 'text-black', 'border-vyapo', 'shadow-[0_0_12px_#F59E0B]');
              badge.classList.remove('bg-black', 'text-vyapo', 'border-white/20');
            }
            if (title) gsap.to(title, { color: '#F59E0B', duration: 0.3 });
            if (status) gsap.to(status, { color: '#34D399', duration: 0.3 });
            if (desc) gsap.to(desc, { color: 'rgba(255, 255, 255, 0.85)', duration: 0.3 });
          } else {
            gsap.to(el, {
              backgroundColor: 'rgba(255, 255, 255, 0.015)',
              borderColor: 'rgba(255, 255, 255, 0.05)',
              boxShadow: 'none',
              x: 0,
              duration: 0.4,
              ease: 'power2.in',
            });

            if (indicator) gsap.to(indicator, { scaleY: 0, duration: 0.3 });
            if (badge) {
              badge.classList.remove('bg-vyapo', 'text-black', 'border-vyapo', 'shadow-[0_0_12px_#F59E0B]');
              badge.classList.add('bg-black', 'text-vyapo', 'border-white/20');
            }
            if (title) gsap.to(title, { color: '#FFFFFF', duration: 0.3 });
            if (status) gsap.to(status, { color: 'rgba(255, 255, 255, 0.4)', duration: 0.3 });
            if (desc) gsap.to(desc, { color: 'rgba(255, 255, 255, 0.5)', duration: 0.3 });
          }
        });
      };

      const startCycling = () => {
        if (cycleTimer) clearInterval(cycleTimer);
        cycleTimer = setInterval(() => {
          const next = (currentStep + 1) % totalSteps;
          activateStep(next);
        }, 2600);
      };

      const stopCycling = () => {
        if (cycleTimer) {
          clearInterval(cycleTimer);
          cycleTimer = null;
        }
      };

      stepCards.forEach((card, idx) => {
        card.addEventListener('click', () => {
          stopCycling();
          activateStep(idx);
          startCycling();
        });
      });

      stepsContainer?.addEventListener('mouseenter', stopCycling);
      stepsContainer?.addEventListener('mouseleave', startCycling);

      activateStep(0);
      startCycling();
    }

    // 4. Centered 3D Kinetic Reviews Slider (Manual Slider & Smooth Drag)
    const stage = document.querySelector('.reviews-stage') as HTMLElement;
    const track = document.getElementById('reviews-track') as HTMLElement;
    const cards = document.querySelectorAll('.review-card');
    const dots = document.querySelectorAll('#reviews-dots button');
    const prevBtn = document.getElementById('prev-review-btn');
    const nextBtn = document.getElementById('next-review-btn');

    if (stage && track && cards.length > 0) {
      const total = cards.length;
      let activeIndex = Math.floor(total / 2); // Start centered at index 2
      let autoPlayInterval: ReturnType<typeof setInterval> | null = null;

      const updateCardStack = () => {
        const stageWidth = stage.clientWidth;
        const activeCard = cards[activeIndex] as HTMLElement;
        const cardWidth = activeCard.offsetWidth;
        const cardLeft = activeCard.offsetLeft;

        // Pin active card directly to stage center
        const targetX = (stageWidth / 2) - (cardLeft + (cardWidth / 2));

        gsap.to(track, {
          x: targetX,
          duration: 0.6,
          ease: 'power3.out',
        });

        cards.forEach((card, i) => {
          const el = card as HTMLElement;
          const indicator = el.querySelector('.review-indicator');
          
          let diff = (i - activeIndex + total) % total;
          if (diff > total / 2) diff -= total;

          if (diff === 0) {
            gsap.to(el, {
              scale: 1,
              opacity: 1,
              rotateY: 0,
              y: 0,
              zIndex: 30,
              borderColor: 'rgba(245, 158, 11, 0.45)',
              backgroundColor: 'rgba(255, 255, 255, 0.05)',
              boxShadow: '0 20px 50px rgba(0,0,0,0.8), 0 0 25px rgba(245, 158, 11, 0.12)',
              duration: 0.5,
              ease: 'power3.out',
            });
            if (indicator) gsap.to(indicator, { scaleY: 1, duration: 0.3 });
          } else if (Math.abs(diff) === 1) {
            const rotY = diff > 0 ? -12 : 12;
            gsap.to(el, {
              scale: 0.86,
              opacity: 0.5,
              rotateY: rotY,
              y: 10,
              zIndex: 10,
              borderColor: 'rgba(255, 255, 255, 0.08)',
              backgroundColor: 'rgba(255, 255, 255, 0.015)',
              boxShadow: '0 10px 30px rgba(0,0,0,0.5)',
              duration: 0.5,
              ease: 'power3.out',
            });
            if (indicator) gsap.to(indicator, { scaleY: 0, duration: 0.3 });
          } else {
            const rotY = diff > 0 ? -18 : 18;
            gsap.to(el, {
              scale: 0.76,
              opacity: 0.2,
              rotateY: rotY,
              y: 18,
              zIndex: 1,
              borderColor: 'rgba(255, 255, 255, 0.05)',
              backgroundColor: 'rgba(255, 255, 255, 0.01)',
              boxShadow: 'none',
              duration: 0.5,
              ease: 'power3.out',
            });
            if (indicator) gsap.to(indicator, { scaleY: 0, duration: 0.3 });
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.classList.add('w-6', 'bg-vyapo');
            dot.classList.remove('w-2', 'bg-white/20');
          } else {
            dot.classList.remove('w-6', 'bg-vyapo');
            dot.classList.add('w-2', 'bg-white/20');
          }
        });
      };

      const startAutoLoop = () => {
        if (autoPlayInterval) clearInterval(autoPlayInterval);
        autoPlayInterval = setInterval(() => {
          activeIndex = (activeIndex + 1) % total;
          updateCardStack();
        }, 4500);
      };

      const stopAutoLoop = () => {
        if (autoPlayInterval) {
          clearInterval(autoPlayInterval);
          autoPlayInterval = null;
        }
      };

      // Button controls
      nextBtn?.addEventListener('click', () => {
        stopAutoLoop();
        activeIndex = (activeIndex + 1) % total;
        updateCardStack();
        startAutoLoop();
      });

      prevBtn?.addEventListener('click', () => {
        stopAutoLoop();
        activeIndex = (activeIndex - 1 + total) % total;
        updateCardStack();
        startAutoLoop();
      });

      // Dot controls
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          stopAutoLoop();
          activeIndex = idx;
          updateCardStack();
          startAutoLoop();
        });
      });

      // Direct card click
      cards.forEach((card, idx) => {
        card.addEventListener('click', () => {
          if (activeIndex !== idx) {
            stopAutoLoop();
            activeIndex = idx;
            updateCardStack();
            startAutoLoop();
          }
        });
      });

      // Unified Pointer Drag Slider (Mouse + Touch)
      let isPointerDown = false;
      let startX = 0;
      let diffX = 0;

      stage.addEventListener('pointerdown', (e: PointerEvent) => {
        isPointerDown = true;
        startX = e.clientX;
        diffX = 0;
        stopAutoLoop();
      });

      window.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isPointerDown) return;
        diffX = e.clientX - startX;
      });

      window.addEventListener('pointerup', () => {
        if (!isPointerDown) return;
        isPointerDown = false;
        if (Math.abs(diffX) > 40) {
          if (diffX < 0) {
            activeIndex = (activeIndex + 1) % total;
          } else {
            activeIndex = (activeIndex - 1 + total) % total;
          }
          updateCardStack();
        }
        startAutoLoop();
      });

      // Mouse Wheel Horizontal Scroll
      stage.addEventListener('wheel', (e: WheelEvent) => {
        if (Math.abs(e.deltaX) > 25 || Math.abs(e.deltaY) > 35) {
          stopAutoLoop();
          if (e.deltaX > 0 || e.deltaY > 0) {
            activeIndex = (activeIndex + 1) % total;
          } else {
            activeIndex = (activeIndex - 1 + total) % total;
          }
          updateCardStack();
          startAutoLoop();
        }
      }, { passive: true });

      stage.addEventListener('mouseenter', stopAutoLoop);
      stage.addEventListener('mouseleave', startAutoLoop);

      window.addEventListener('resize', updateCardStack);

      updateCardStack();
      startAutoLoop();
    }
  };

  document.addEventListener('DOMContentLoaded', initPageInteractions);
  document.addEventListener('astro:page-load', initPageInteractions);
</script>