---
import Layout from '../layouts/Layout.astro';

const articles = [
  {
    id: "01",
    tag: "Textile Market",
    date: "OCT 2026",
    readTime: "6 min read",
    level: "सूरत कपड़ा बाज़ार",
    title: "सूरत के कपड़ा निर्माताओं का नया डिजिटल तरीका",
    summary: "सूरत और भिवंडी की कपड़ा मिलें अब बिना किसी लंबी उधारी के सीधे देश भर के थोक व्यापारियों और दुकानदारों से जुड़ रही हैं और तुरंत डिजिटल पेमेंट पा रही हैं।",
    stat: "40% तेज़ पेमेंट",
    slug: "/insights/surat-textile-revolution",
    image: "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=800&q=80",
    imgAlt: "कपड़ा मिल और मैन्युफैक्चरिंग"
  },
  {
    id: "02",
    tag: "Retail & Kirana",
    date: "SEP 2026",
    readTime: "8 min read",
    level: "किराना दुकान",
    title: "दुकानदारों की दो महीने की उधारी का पक्का हल",
    summary: "किराना और खुदरा व्यापारियों के लिए पैसे की तंगी दूर करने का आसान रास्ता: सीधे थोक सप्लाई और फोन पर स्टॉक देखकर काम करने से हर महीने कैश की बचत कैसे होती है।",
    stat: "₹15 लाख+ फंसा पैसा चालू",
    slug: "/insights/kirana-retail-credit-cycle",
    image: "https://images.unsplash.com/photo-1506484381205-f7945653044d?auto=format&fit=crop&w=800&q=80",
    imgAlt: "भारतीय किराना दुकान और बाज़ार"
  },
  {
    id: "03",
    tag: "Manufacturing",
    date: "AUG 2026",
    readTime: "10 min read",
    level: "फैक्ट्री और उत्पादन",
    title: "छोटे शहरों की फैक्ट्रियों में सामान की सीधी जांच",
    summary: "कच्चा माल खरीदने से लेकर माल पैक होने तक—जब छोटे कारखाने अपने काम और स्टॉक की सही जानकारी ऑनलाइन दिखाते हैं, तो उनके डीलर और खरीदार तेजी से बढ़ते हैं।",
    stat: "100% सही स्टॉक",
    slug: "/insights/tier-2-manufacturing-audit",
    image: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80",
    imgAlt: "कारखाना और असेंबली प्लांट"
  },
  {
    id: "04",
    tag: "Agri-Wholesale",
    date: "JUL 2026",
    readTime: "7 min read",
    level: "अनाज मंडी और तेल मिल",
    title: "मंडियों से सीधे गोदाम तक माल भेजने का आसान तरीका",
    summary: "सोयाबीन, दाल और तेल मिलों से निकलने वाले बड़े ऑर्डरों को बिना किसी बिचौलिए या लिखा-पढ़ी की गलती के सीधे बड़े गोदामों तक पहुंचाने की ग्राउंड रिपोर्ट।",
    stat: "खाते में शून्य गड़बड़ी",
    slug: "/insights/agri-mandi-direct-logistics",
    image: "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=800&q=80",
    imgAlt: "ट्रक और ट्रांसपोर्ट लॉजिस्टिक्स"
  }
];

const categories = ["सभी लेख", "कपड़ा व्यापार", "फैक्ट्री व उद्योग", "किराना व रिटेल", "मंडी व अनाज"];
---

<Layout title="Industry Insights & Research | Vyaparnama">
  <div class="relative w-full max-w-full overflow-x-clip bg-transparent text-white selection:bg-[#FCA500] selection:text-black">
    
    <!-- Ambient Vyapo Glow Spots -->
    <div class="absolute -top-32 right-0 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] bg-[#FCA500]/10 rounded-full blur-[130px] pointer-events-none mix-blend-screen -z-10"></div>
    <div class="absolute top-1/2 left-0 w-[250px] sm:w-[400px] h-[250px] sm:h-[400px] bg-[#FCA500]/10 rounded-full blur-[140px] pointer-events-none mix-blend-screen -z-10"></div>

    <section class="w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-28 sm:pt-36 pb-24 relative z-10 box-border">
      
      <!-- HERO HEADER -->
      <div class="max-w-4xl mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 font-mono text-[11px] uppercase tracking-[0.25em] text-[#FCA500] mb-5 blog-header-elem">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FCA500] animate-ping"></span>
          व्यापार और सप्लाई चेन की ताज़ा जानकारी
        </div>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight leading-[0.94] blog-header-elem font-baloo">
          व्यापार रिपोर्ट <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-[#FCA500]">
            और ज़मीनी रिसर्च
          </span>
        </h1>
        <p class="text-white/70 text-base sm:text-xl font-normal mt-5 leading-relaxed blog-header-elem max-w-2xl font-baloo">
          भारतीय बाज़ार, दुकानदारों की उधारी की समस्या और सीधे सामान मंगाने के नए तरीकों पर आसान और सच्ची रिपोर्ट्स।
        </p>
      </div>

      <!-- FILTER TABS -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-10 border-b border-white/10 no-scrollbar blog-header-elem">
        {categories.map((cat, i) => (
          <button 
            class={`px-3.5 py-1.5 rounded-full text-xs font-baloo uppercase tracking-wider transition-all duration-300 whitespace-nowrap cursor-default ${
              i === 0 
                ? 'bg-[#FCA500] text-black font-bold shadow-[0_0_15px_rgba(252,165,0,0.4)]' 
                : 'bg-white/[0.03] text-white/60 hover:text-white border border-white/10 hover:border-white/30'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- ARTICLE ARCHIVE CONTAINER -->
      <div class="article-archive relative border-t border-white/10">
        {articles.map((item) => (
          <a
            href={item.slug}
            class="article-item block group py-8 sm:py-10 border-b border-white/10 relative cursor-default transition-all duration-500 hover:bg-white/[0.015] px-3 sm:px-5 -mx-3 sm:-mx-5 rounded-2xl"
            data-stat={item.stat}
            data-level={item.level}
            data-read={item.readTime}
            data-img={item.image}
          >
            <!-- Yellow/Gold Left Border Glow Accent on Hover -->
            <div class="absolute left-0 top-0 bottom-0 w-[2px] bg-[#FCA500] scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-top"></div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-8 items-center">
              
              <!-- IMAGE PREVIEW -->
              <div class="md:col-span-4 lg:col-span-3">
                <div class="relative w-full aspect-[16/10] sm:aspect-[16/9] md:aspect-[4/3] rounded-xl overflow-hidden bg-black/40 border border-white/10 group-hover:border-[#FCA500]/40 transition-colors duration-500">
                  <img 
                    src={item.image} 
                    alt={item.imgAlt} 
                    class="article-thumbnail w-full h-full object-cover grayscale contrast-125 brightness-75 group-hover:grayscale-0 group-hover:brightness-100 group-hover:scale-105 transition-all duration-700 ease-out"
                    loading="lazy"
                  />
                  <!-- Vignette & Warm Tint -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
                  <div class="absolute inset-0 bg-[#FCA500]/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none mix-blend-color"></div>

                  <!-- Tag Pill -->
                  <div class="absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded-md bg-black/70 backdrop-blur-md border border-white/15 text-[10px] font-mono uppercase tracking-widest text-white/80">
                    {item.tag}
                  </div>
                </div>
              </div>

              <!-- CONTENT COLUMN -->
              <div class="md:col-span-6 lg:col-span-7 title-container transition-transform duration-300 group-hover:translate-x-1 sm:group-hover:translate-x-2">
                <div class="flex items-center gap-3 mb-2 font-mono">
                  <span class="text-xs font-bold text-[#FCA500]">
                    {item.id}
                  </span>
                  <span class="text-xs text-white/40 tracking-wider">
                    {item.date}
                  </span>
                </div>

                <!-- Heading -->
                <h3 class="font-baloo text-2xl sm:text-3xl lg:text-[28px] font-bold text-white group-hover:text-[#FCA500] transition-colors tracking-tight leading-snug mb-2">
                  {item.title}
                </h3>
                
                <!-- Summary -->
                <p class="font-baloo text-white/60 text-sm sm:text-base font-normal leading-relaxed line-clamp-2 sm:line-clamp-3">
                  {item.summary}
                </p>
                
                <!-- Informative Metric Chips -->
                <div class="flex flex-wrap items-center gap-3 mt-4 font-mono text-[10px] sm:text-[11px] text-white/40">
                  <span class="flex items-center gap-1.5 text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded-md border border-emerald-400/20 font-baloo">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    {item.stat}
                  </span>
                  <span>•</span>
                  <span>{item.readTime}</span>
                  <span>•</span>
                  <span class="text-white/70 font-baloo">{item.level}</span>
                </div>
              </div>

              <!-- ACTION ARROW (Desktop only) -->
              <div class="md:col-span-2 hidden md:flex items-center justify-end">
                <div class="w-10 h-10 rounded-full border border-white/15 flex items-center justify-center text-white/60 group-hover:text-black group-hover:bg-[#FCA500] group-hover:border-[#FCA500] transition-all duration-300 transform group-hover:rotate-45 shadow-lg">
                  <span class="text-sm font-bold">↗</span>
                </div>
              </div>

            </div>
          </a>
        ))}
      </div>

      <!-- DESKTOP GSAP FLOATING TELEMETRY INSPECTOR -->
      <div 
        id="article-floating-inspector" 
        class="fixed top-0 left-0 pointer-events-none opacity-0 z-50 rounded-xl bg-black/95 border border-[#FCA500]/40 p-3.5 backdrop-blur-xl shadow-[0_10px_35px_rgba(0,0,0,0.9)] hidden lg:block -translate-x-1/2 -translate-y-1/2 min-w-[220px]"
      >
        <div class="flex items-center justify-between text-[10px] font-mono text-[#FCA500] uppercase tracking-wider mb-1.5 pb-1 border-b border-white/10">
          <span>लाइव डेटा</span>
          <span id="inspect-read">--</span>
        </div>
        <p id="inspect-level" class="text-xs font-bold text-white uppercase tracking-tight mb-1 font-baloo">सेक्टर</p>
        <div class="text-[11px] font-mono text-emerald-400 flex items-center gap-1.5 font-baloo">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="inspect-stat">सत्यापित आंकड़ा</span>
        </div>
      </div>

    </section>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initBlogAnimations = () => {
    // 1. Header entrance
    gsap.fromTo(
      '.blog-header-elem',
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: 'power3.out', delay: 0.1 }
    );

    // 2. Article rows stagger entrance
    const items = document.querySelectorAll('.article-item');
    if (!items.length) return;

    gsap.fromTo(
      items,
      { y: 40, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        stagger: 0.14,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.article-archive',
          start: 'top 85%',
        }
      }
    );

    // 3. Mobile Viewport Center Spotlight Trigger
    const isMobile = window.matchMedia('(max-width: 1023px)').matches;

    if (isMobile) {
      items.forEach((item) => {
        const thumb = item.querySelector('.article-thumbnail');
        const title = item.querySelector('h3');
        const orangeLine = item.querySelector('.absolute.left-0');
        const overlay = item.querySelector('.mix-blend-color');

        ScrollTrigger.create({
          trigger: item,
          start: 'top 65%',
          end: 'bottom 35%',
          toggleActions: 'play reverse play reverse',
          onEnter: () => activateCard(),
          onEnterBack: () => activateCard(),
          onLeave: () => deactivateCard(),
          onLeaveBack: () => deactivateCard(),
        });

        function activateCard() {
          gsap.to(item, {
            backgroundColor: 'rgba(255, 255, 255, 0.04)',
            borderColor: 'rgba(252, 165, 0, 0.4)',
            duration: 0.4,
            ease: 'power2.out'
          });

          if (thumb) {
            gsap.to(thumb, {
              filter: 'grayscale(0%) contrast(100%) brightness(100%)',
              scale: 1.04,
              duration: 0.5,
              ease: 'power2.out'
            });
          }

          if (title) {
            gsap.to(title, { color: '#FCA500', x: 4, duration: 0.3 });
          }

          if (orangeLine) {
            gsap.to(orangeLine, { scaleY: 1, duration: 0.35, ease: 'power2.out' });
          }

          if (overlay) {
            gsap.to(overlay, { opacity: 1, duration: 0.4 });
          }
        }

        function deactivateCard() {
          gsap.to(item, {
            backgroundColor: 'transparent',
            borderColor: 'rgba(255, 255, 255, 0.1)',
            duration: 0.4,
            ease: 'power2.in'
          });

          if (thumb) {
            gsap.to(thumb, {
              filter: 'grayscale(100%) contrast(125%) brightness(75%)',
              scale: 1,
              duration: 0.5,
              ease: 'power2.in'
            });
          }

          if (title) {
            gsap.to(title, { color: '#FFFFFF', x: 0, duration: 0.3 });
          }

          if (orangeLine) {
            gsap.to(orangeLine, { scaleY: 0, duration: 0.3, ease: 'power2.in' });
          }

          if (overlay) {
            gsap.to(overlay, { opacity: 0, duration: 0.4 });
          }
        }
      });
    }

    // 4. Desktop Floating Telemetry Inspector
    if (window.matchMedia('(pointer: fine)').matches) {
      const inspector = document.getElementById('article-floating-inspector');
      const inspectStat = document.getElementById('inspect-stat');
      const inspectLevel = document.getElementById('inspect-level');
      const inspectRead = document.getElementById('inspect-read');

      if (inspector) {
        const xTo = gsap.quickTo(inspector, 'x', { duration: 0.25, ease: 'power2.out' });
        const yTo = gsap.quickTo(inspector, 'y', { duration: 0.25, ease: 'power2.out' });

        window.addEventListener('mousemove', (e) => {
          xTo(e.clientX + 130);
          yTo(e.clientY - 20);
        });

        items.forEach((item) => {
          item.addEventListener('mouseenter', () => {
            if (inspectStat && inspectLevel && inspectRead) {
              inspectStat.textContent = item.getAttribute('data-stat') || '';
              inspectLevel.textContent = item.getAttribute('data-level') || '';
              inspectRead.textContent = item.getAttribute('data-read') || '';
            }

            gsap.to(inspector, {
              opacity: 1,
              scale: 1,
              duration: 0.25,
              ease: 'power2.out',
            });
          });

          item.addEventListener('mouseleave', () => {
            gsap.to(inspector, {
              opacity: 0,
              scale: 0.9,
              duration: 0.2,
              ease: 'power2.in',
            });
          });
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', initBlogAnimations);
  document.addEventListener('astro:page-load', initBlogAnimations);
</script>