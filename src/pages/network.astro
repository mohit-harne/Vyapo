---
import Layout from '../layouts/Layout.astro';
import TextReveal from '../components/TextReveal.jsx';
---

<Layout title="The Network">
  <section class="pt-40 pb-20 px-6 max-w-7xl mx-auto min-h-screen">
    <TextReveal client:load className="mb-32">
      <h1 class="text-6xl md:text-[8vw] leading-[0.9] font-black uppercase tracking-tighter">
        The Merchant <br/>
        <span class="text-transparent [-webkit-text-stroke:1px_#ffffff] opacity-50">Ecosystem.</span>
      </h1>
    </TextReveal>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-32">
      <TextReveal client:load>
        <p class="text-2xl md:text-4xl font-light text-white/70 leading-snug">
          Connecting B2B and B2C seamlessly. We streamline the entire product journey, from manufacturing directly to the end customer[cite: 2].
        </p>
      </TextReveal>

      <TextReveal client:load>
        <div class="space-y-12">
          <div class="border-l border-vyapo pl-8 relative">
            <div class="absolute w-3 h-3 bg-vyapo rounded-full -left-[6px] top-2 shadow-[0_0_10px_#F59E0B]"></div>
            <h3 class="text-3xl font-bold mb-4 uppercase tracking-wider">Manufacturers</h3>
            <p class="text-white/60 text-lg leading-relaxed">
              The origin point. Manufacturers utilize Vyapo's virtual inventory system to create and manage stock, retaining the power to decide exactly whom they want to sell to[cite: 2].
            </p>
          </div>

          <div class="border-l border-white/20 pl-8 relative">
            <div class="absolute w-3 h-3 bg-white/20 rounded-full -left-[6px] top-2"></div>
            <h3 class="text-3xl font-bold mb-4 uppercase tracking-wider">Wholesalers & Distributors</h3>
            <p class="text-white/60 text-lg leading-relaxed">
              Wholesalers purchase from manufacturers and sell to retailers. Distributors operate as authorized stockists for specific companies within our digital merchant directory[cite: 2].
            </p>
          </div>

          <div class="border-l border-white/20 pl-8 relative">
            <div class="absolute w-3 h-3 bg-white/20 rounded-full -left-[6px] top-2"></div>
            <h3 class="text-3xl font-bold mb-4 uppercase tracking-wider">Retailers</h3>
            <p class="text-white/60 text-lg leading-relaxed">
              Empowered by virtual inventory. Retailers can buy from wholesalers, distributors, or directly from manufacturers, effortlessly integrating this inventory with their sales process for end consumers[cite: 2].
            </p>
          </div>
        </div>
      </TextReveal>
    </div>
  </section>
</Layout>