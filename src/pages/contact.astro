    handle: '@VyapoHQ',
    icon: `<path fill="#FFFFFF" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`
  },
  {
    name: 'WhatsApp',
    href: 'https://wa.me/919890229131',
    handle: '+91 98902 29131',
    icon: `<path fill="#25D366" d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24M8.53 7.33c-.16 0-.35.06-.53.26-.18.2-.7 1.28-.7 1.7 0 .42.18.9.36 1.1.18.2 1.35 2.19 3.37 3.01 1.68.68 2.02.55 2.38.51.36-.04 1.17-.48 1.33-.94.16-.46.16-.86.11-.94-.05-.08-.18-.13-.38-.23s-1.17-.58-1.35-.65c-.18-.07-.31-.11-.44.11-.13.22-.51.65-.63.78-.12.13-.24.15-.44.05-.2-.1-1.04-.38-1.98-1.22-.73-.65-1.22-1.46-1.36-1.7-.14-.24-.01-.37.09-.47.09-.09.2-.24.3-.36.1-.12.13-.2.2-.34.07-.14.03-.26-.02-.36s-.44-1.06-.6-1.46c-.16-.39-.32-.34-.44-.35-.11-.01-.24-.01-.37-.01z"/>`
  }
  
];
---

<Layout title="Contact Us | Vyapo">
  <div class="relative bg-transparent text-white selection:bg-vyapo selection:text-black">
    
    <!-- Ambient Lighting -->
    <div class="absolute -top-40 right-10 w-[500px] h-[500px] bg-vyapo/10 rounded-full blur-[140px] pointer-events-none mix-blend-screen -z-10"></div>
    <div class="absolute top-[40%] -left-32 w-[400px] h-[400px] bg-amber-500/10 rounded-full blur-[130px] pointer-events-none mix-blend-screen -z-10"></div>

    <section class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-36 pb-28 relative z-10">
      
      <!-- HERO HEADER -->
      <div class="contact-header mb-16 lg:mb-24">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 font-mono text-xs uppercase tracking-[0.25em] text-vyapo mb-6 header-elem">
          <span class="w-1.5 h-1.5 rounded-full bg-vyapo animate-ping"></span>
          Direct Dispatch & Inquiries
        </div>
        <h1 class="text-5xl sm:text-7xl lg:text-8xl font-black uppercase tracking-tight leading-[0.92] header-elem">
          Let’s Build <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-vyapo">
            The Network.
          </span>
        </h1>
        <p class="text-white/60 text-lg sm:text-xl font-light max-w-2xl mt-6 header-elem">
          Whether you are a manufacturer minting stock units, a regional wholesaler, or a retailer scaling footfall—we respond within 4 business hours.
        </p>
      </div>

      <!-- MAIN SPLIT: CONTACT INFO + INQUIRY FORM -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-24">
        
        <!-- LEFT COLUMN: Quick Desks & Headquarters Details -->
        <div class="lg:col-span-5 space-y-8 contact-left">
          
          <div class="space-y-6">
            <!-- Email Partner Desk -->
            <div class="desk-card p-6 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md hover:border-vyapo/50 transition-colors duration-300">
              <span class="text-xs font-mono text-white/40 uppercase tracking-widest block mb-2">Direct Partner Desk</span>
              <MagneticButton client:load href="mailto:info@vyapo.com" className="cursor-none inline-block">
                <span class="text-2xl sm:text-3xl font-bold tracking-tight text-white hover:text-vyapo transition-colors">
                  info@vyapo.com
                </span>
              </MagneticButton>
            </div>

            <!-- WhatsApp Direct Desk -->
            <div class="desk-card p-6 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md hover:border-emerald-500/50 transition-colors duration-300">
              <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest flex items-center gap-2 mb-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Official WhatsApp Desk
              </span>
              <MagneticButton client:load href="https://wa.me/919890229131" className="cursor-none inline-block">
                <span class="text-2xl sm:text-3xl font-bold tracking-tight text-white hover:text-emerald-400 transition-colors">
                  +91 98902 29131
                </span>
              </MagneticButton>
            </div>
          </div>

          <!-- Headquarters Card -->
          <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md space-y-3">
            <span class="text-xs font-mono text-vyapo uppercase tracking-widest block">Maharashtra HQ</span>
            <p class="text-xl font-bold text-white uppercase tracking-tight">Vishwalata Ventures Private Limited</p>
            <p class="text-white/60 text-sm font-light leading-relaxed">
             Shop No. 20, G.M. Arcade, Opposite City Council,<br/> Main Road, Paratwada – 444805
            </p>
            <div class="pt-2">
              <span class="inline-flex items-center gap-2 font-mono text-xs text-white/40">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Coordinates: 21.2975° N, 77.5163° E
              </span>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: Interactive Inquiry Form -->
        <div class="lg:col-span-7 inquiry-panel">
          <div class="p-8 sm:p-12 rounded-3xl bg-white/[0.03] border border-white/10 backdrop-blur-xl relative overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.6)]">
            
            <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/10">
              <div>
                <h3 class="text-2xl font-bold uppercase tracking-tight text-white">Merchant Inquiry</h3>
                <p class="text-xs font-mono text-white/50 uppercase tracking-wider mt-1">Connect with wholesale distribution engineers</p>
              </div>
              <span class="font-mono text-xs text-vyapo px-3 py-1 bg-vyapo/10 rounded-full border border-vyapo/20">Step 01/01</span>
            </div>

            <form id="contact-form" class="space-y-6">
              
              <!-- Name & Phone -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="form-group relative">
                  <label class="block text-xs font-mono uppercase tracking-widest text-white/60 mb-2">Full Name</label>
                  <input 
                    type="text" 
                    required 
                    placeholder="e.g. Ramesh Patel" 
                    class="w-full bg-black/40 border border-white/15 rounded-xl px-4 py-3.5 text-sm text-white focus:outline-none focus:border-vyapo transition-colors placeholder:text-white/20 cursor-none"
                  />
                </div>

                <div class="form-group relative">
                  <label class="block text-xs font-mono uppercase tracking-widest text-white/60 mb-2">WhatsApp / Phone</label>
                  <input 
                    type="tel" 
                    required 
                    placeholder="+91 98902 29131" 
                    class="w-full bg-black/40 border border-white/15 rounded-xl px-4 py-3.5 text-sm text-white focus:outline-none focus:border-vyapo transition-colors placeholder:text-white/20 cursor-none"
                  />
                </div>
              </div>

              <!-- Enterprise Name & Ecosystem Role -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="form-group relative">
                  <label class="block text-xs font-mono uppercase tracking-widest text-white/60 mb-2">Firm / Business Name</label>
                  <input 
                    type="text" 
                    required 
                    placeholder="e.g. Patel Agro & Seeds" 
                    class="w-full bg-black/40 border border-white/15 rounded-xl px-4 py-3.5 text-sm text-white focus:outline-none focus:border-vyapo transition-colors placeholder:text-white/20 cursor-none"
                  />
                </div>

                <div class="form-group relative">
                  <label class="block text-xs font-mono uppercase tracking-widest text-white/60 mb-2">Ecosystem Role</label>
                  <select 
                    class="w-full bg-black/40 border border-white/15 rounded-xl px-4 py-3.5 text-sm text-white focus:outline-none focus:border-vyapo transition-colors appearance-none cursor-none"
                  >
                    <option value="retailer" class="bg-[#0a0a0a] text-white">Local Retailer / Storefront</option>
                    <option value="wholesaler" class="bg-[#0a0a0a] text-white">Wholesaler / Regional Stockist</option>
                    <option value="distributor" class="bg-[#0a0a0a] text-white">Exclusive Area Distributor</option>
                    <option value="manufacturer" class="bg-[#0a0a0a] text-white">Brand / Factory Manufacturer</option>
                  </select>
                </div>
              </div>

              <!-- Message -->
              <div class="form-group relative">
                <label class="block text-xs font-mono uppercase tracking-widest text-white/60 mb-2">Requirements / Message</label>
                <textarea 
                  rows="4" 
                  placeholder="Tell us about your distribution volume or inventory inquiry..." 
                  class="w-full bg-black/40 border border-white/15 rounded-xl p-4 text-sm text-white focus:outline-none focus:border-vyapo transition-colors placeholder:text-white/20 resize-none cursor-none"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <button 
                type="submit" 
                id="submit-btn" 
                class="cursor-none w-full py-4 rounded-xl bg-vyapo text-black font-black uppercase text-xs tracking-[0.25em] hover:bg-white transition-all duration-300 shadow-[0_0_25px_rgba(245,158,11,0.25)] flex items-center justify-center gap-3 group"
              >
                <span>Transmit Inquiry</span>
                <span class="transform group-hover:translate-x-1.5 transition-transform duration-300">→</span>
              </button>

              <div id="form-feedback" class="hidden text-center text-xs font-mono text-vyapo pt-2">
                ✓ Inquiry dispatched. An integration engineer will contact you shortly.
              </div>

            </form>
          </div>
        </div>

      </div>

      <!-- SECTION 2: SOCIAL NETWORK MATRIX -->
      <div class="socials-section border-t border-white/10 pt-16 mb-24">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-10">
          <div>
            <span class="text-xs font-mono text-vyapo uppercase tracking-widest block mb-2">Ecosystem Channels</span>
            <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Connect Everywhere.</h2>
          </div>
          <p class="text-sm font-mono text-white/40">Real-time alerts, daily market bulletins & engineering updates</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 socials-grid">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-tile cursor-none p-5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-white/30 backdrop-blur-md transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1"
            >
              <div class="w-10 h-10 rounded-xl bg-white/[0.04] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5" viewBox="0 0 24 24" set:html={s.icon} />
              </div>
              <div>
                <p class="text-sm font-bold text-white group-hover:text-vyapo transition-colors uppercase tracking-wide">{s.name}</p>
                <p class="text-[11px] font-mono text-white/40 truncate mt-0.5">{s.handle}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- SECTION 3: DARK GOOGLE MAPS SHOWCASE WITH CUSTOM CURSOR SHIELD -->
      <div class="map-section border-t border-white/10 pt-16">
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="text-xs font-mono text-vyapo uppercase tracking-widest block mb-1">Coordinates</span>
            <h3 class="text-3xl font-black uppercase tracking-tight text-white">Central Operations Center</h3>
          </div>
          <a
            href={googleMapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-none hidden sm:inline-flex items-center gap-2 text-xs font-mono uppercase text-vyapo hover:text-white transition-colors"
          >
            <span>Open in Google Maps</span>
            <span>↗</span>
          </a>
        </div>

        <div class="map-wrapper relative w-full h-[420px] sm:h-[480px] rounded-3xl overflow-hidden border border-white/15 shadow-[0_20px_50px_rgba(0,0,0,0.8)] bg-[#0d0d0d] cursor-none group/map">
          
          <!-- Ultra Dark Hardware Matrix Filter on Map Iframe centered on PrimaThink coordinates -->
          <iframe
            id="gmap-iframe"
            title="Vyapo Location"
            src="https://maps.google.com/maps?q=20.9625949,77.7790471&hl=en&z=17&output=embed"
            width="100%"
            height="100%"
            style="border:0; filter: invert(92%) hue-rotate(180deg) contrast(135%) grayscale(25%);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full pointer-events-none"
          ></iframe>

          <!-- Interaction Shield: Prevents iframe from swallowing mousemove events and showing native cursor -->
          <div 
            id="map-shield" 
            class="absolute inset-0 z-20 cursor-none flex items-center justify-center bg-black/0 hover:bg-black/20 transition-colors duration-300 group-hover/map:backdrop-blur-[1px]"
          >
            <div id="shield-hint" class="opacity-0 group-hover/map:opacity-100 transition-opacity duration-300 px-4 py-2 rounded-full bg-black/80 border border-white/20 text-[11px] font-mono text-white/80 pointer-events-none shadow-xl">
              Click to Interact with Map
            </div>
          </div>

          <!-- Floating Info Pill over Map -->
          <div class="absolute bottom-6 left-6 z-30 max-w-xs p-5 rounded-2xl bg-black/85 backdrop-blur-md border border-white/15 pointer-events-none shadow-2xl">
            <div class="flex items-center gap-2 mb-2 font-mono text-[10px] text-vyapo uppercase tracking-widest">
              <span class="w-1.5 h-1.5 rounded-full bg-vyapo animate-ping"></span>
              Live Node Center
            </div>
            <h4 class="text-sm font-bold text-white uppercase">PrimaThink // Vyapo Operations</h4>
            <p class="text-white/50 text-xs mt-1 font-light leading-relaxed">
              Badnera Road, Near Rajapeth, Amravati, Maharashtra 444601.
            </p>
          </div>

        </div>
      </div>

    </section>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const initContactMotion = () => {
    // 1. Initial Hero Stagger
    gsap.fromTo(
      '.header-elem',
      { y: 50, opacity: 0 },
      { y: 0, opacity: 1, duration: 1, stagger: 0.12, ease: 'power4.out', delay: 0.2 }
    );

    // 2. Desk Cards & Form Entrance
    gsap.fromTo(
      '.desk-card',
      { x: -40, opacity: 0 },
      { y: 0, x: 0, opacity: 1, duration: 0.9, stagger: 0.15, ease: 'power3.out', delay: 0.4 }
    );

    gsap.fromTo(
      '.inquiry-panel',
      { scale: 0.96, opacity: 0, y: 30 },
      { scale: 1, opacity: 1, y: 0, duration: 1, ease: 'power3.out', delay: 0.4 }
    );

    // 3. Social Grid ScrollTrigger Reveal
    gsap.fromTo(
      '.social-tile',
      { y: 40, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        stagger: 0.08,
        duration: 0.8,
        ease: 'back.out(1.4)',
        scrollTrigger: {
          trigger: '.socials-grid',
          start: 'top 85%',
        }
      }
    );

    // 4. Map Reveal with Expanding Clip Path
    gsap.fromTo(
      '.map-wrapper',
      { clipPath: 'inset(12% 8% 12% 8% round 32px)', opacity: 0.3 },
      {
        clipPath: 'inset(0% 0% 0% 0% round 24px)',
        opacity: 1,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.map-wrapper',
          start: 'top 80%',
        }
      }
    );

    // 5. Form Submit Handler
    const form = document.getElementById('contact-form');
    const feedback = document.getElementById('form-feedback');
    const btn = document.getElementById('submit-btn');

    if (form instanceof HTMLFormElement && feedback && btn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        btn.textContent = 'Transmitting...';
        btn.style.opacity = '0.7';

        setTimeout(() => {
          btn.style.display = 'none';
          feedback.classList.remove('hidden');
          gsap.fromTo(feedback, { y: 10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5 });
          form.reset();
        }, 800);
      });
    }

    // 6. Map Custom Cursor Shield Controller
    const shield = document.getElementById('map-shield');
    const iframe = document.getElementById('gmap-iframe');
    const hint = document.getElementById('shield-hint');

    if (shield && iframe && hint) {
      shield.addEventListener('click', () => {
        shield.style.pointerEvents = 'none';
        iframe.style.pointerEvents = 'auto';
        hint.style.display = 'none';
      });

      const wrapper = shield.closest('.map-wrapper');
      if (wrapper) {
        wrapper.addEventListener('mouseleave', () => {
          shield.style.pointerEvents = 'auto';
          iframe.style.pointerEvents = 'none';
          hint.style.display = 'block';
        });
      }
    }
  };

  document.addEventListener('DOMContentLoaded', initContactMotion);
  document.addEventListener('astro:page-load', initContactMotion);
</script>